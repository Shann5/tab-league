{
  "name": "tab-league",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p extension/jsconfig.json && tsc -p brain/jsconfig.json",
    "test": "node test/extension.test.mjs",
    "test:brain": "node --test tests/*.test.mjs",
    "test:views": "node --test test/views.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "playwright-core": "latest",
    "typescript": "latest"
  },
